+void Netplay::SetLocalPort(s32 port)
+{
+  s_forced_local_port = port;
+}
+
+void Netplay::SetPeerAddress(s32 player_id, const std::string& host, s32 port)
+{
+  if (player_id < 0 || player_id >= MAX_PLAYERS)
+    return;
+  ENetAddress a = {};
+  if (enet_address_set_host(&a, host.c_str()) != 0)
+    return;
+  a.port = static_cast<u16>(port);
+  s_peer_override[player_id] = a;
+  s_peer_override_set[player_id] = true;
+}
+
+void Netplay::SetCheatFile(const std::string& path)
+{
+  s_cheat_file = path;
+}
+
+// Dabrezz Retro: carga los trucos de la sesion si no estan (cargar un estado de otro jugador, o un reinicio de la sesion, vacia la lista) y los activa TODOS. Se llama antes de cada fotograma
+// en todos los jugadores, asi la partida empieza con los mismos trucos en todos.
+void Netplay::EnsureSessionCheats()
+{
+  if (s_cheat_file.empty() || System::HasCheatList())
+    return;
+  if (!System::LoadCheatList(s_cheat_file.c_str()))
+  {
+    Log_ErrorPrintf("Netplay: no se pudieron cargar los trucos de '%s'", s_cheat_file.c_str());
+    s_cheat_file.clear(); // no se reintenta cada fotograma
+    return;
+  }
+  CheatList* cl = System::GetCheatList();
+  if (cl)
+  {
+    for (u32 i = 0; i < cl->GetCodeCount(); i++)
+      cl->SetCodeEnabled(i, true);
+    Log_InfoPrintf("Netplay: %u trucos de la sesion cargados y activos", cl->GetCodeCount());
+  }
+}
+
+void Netplay::SetRequestedPlayer(s32 player_id)
+{
+  s_requested_player = player_id;
+}
+
+void Netplay::SetExpectedPlayers(s32 players)
+{
+  s_expected_players = players < 0 ? 0 : (players > MAX_PLAYERS ? MAX_PLAYERS : players);
+}
+
+void Netplay::SetInputDelay(s32 frames)
+{
+  s_forced_input_delay = frames < 0 ? 0 : (frames > 10 ? 10 : frames);
+}
